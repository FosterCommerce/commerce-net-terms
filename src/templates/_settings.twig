{% import '_includes/forms' as forms %}

{% embed '_includes/forms/field' with { label: 'settings.billing'|t('net-terms') } %}
	{% block input %}
		{% if netTermsGateway %}
			<p>
				{{ (isOrderBilling ? 'settings.billingOrders' : 'settings.billingInvoices')|t('net-terms', { gateway: netTermsGateway.name }) }}
				<a href="{{ netTermsGateway.getCpEditUrl() }}">{{ 'settings.editGateway'|t('net-terms') }}</a>
			</p>
		{% else %}
			<p>
				{{ 'settings.billingNoGateway'|t('net-terms') }}
				<a href="{{ cpUrl('commerce/settings/gateways/new') }}">{{ 'settings.addGateway'|t('net-terms') }}</a>
			</p>
		{% endif %}
	{% endblock %}
{% endembed %}

<hr>

{{ forms.lightswitchField({
	label: 'settings.defaultSublimitMode'|t('net-terms'),
	instructions: 'settings.defaultSublimitModeInstructions'|t('net-terms'),
	id: 'defaultSublimitMode',
	name: 'defaultSublimitMode',
	value: 'reserved',
	on: settings.defaultSublimitMode == 'reserved',
	errors: settings.getErrors('defaultSublimitMode'),
}) }}

{{ forms.textField({
	label: 'settings.defaultPaymentTerms'|t('net-terms'),
	instructions: 'settings.defaultPaymentTermsInstructions'|t('net-terms'),
	id: 'defaultPaymentTerms',
	name: 'defaultPaymentTerms',
	type: 'number',
	min: 0,
	size: 6,
	value: settings.defaultPaymentTerms,
	errors: settings.getErrors('defaultPaymentTerms'),
}) }}

{% if not isOrderBilling %}
	{{ forms.textField({
		label: 'settings.invoiceNumberPrefix'|t('net-terms'),
		instructions: 'settings.invoiceNumberPrefixInstructions'|t('net-terms'),
		id: 'invoiceNumberPrefix',
		name: 'invoiceNumberPrefix',
		value: settings.invoiceNumberPrefix,
		placeholder: 'INV-',
		maxlength: 20,
		size: 10,
		errors: settings.getErrors('invoiceNumberPrefix'),
	}) }}

	{{ forms.textField({
		label: 'settings.invoiceNumberStart'|t('net-terms'),
		instructions: 'settings.invoiceNumberStartInstructions'|t('net-terms'),
		id: 'invoiceNumberStart',
		name: 'invoiceNumberStart',
		inputmode: 'numeric',
		size: 10,
		value: '%06d'|format(settings.invoiceNumberStart),
		errors: settings.getErrors('invoiceNumberStart'),
	}) }}
{% else %}
	{# Post the invoice settings unchanged, since a save keeps only the settings it posts #}
	{{ hiddenInput('invoiceNumberPrefix', settings.invoiceNumberPrefix) }}
	{{ hiddenInput('invoiceNumberStart', settings.invoiceNumberStart) }}
	{{ hiddenInput('invoicePath', settings.invoicePath) }}
{% endif %}

<hr>

<h2>{{ 'settings.emails'|t('net-terms') }}</h2>

{% if not isOrderBilling %}
	{{ forms.textField({
		label: 'settings.invoicePath'|t('net-terms'),
		instructions: 'settings.invoicePathInstructions'|t('net-terms'),
		id: 'invoicePath',
		name: 'invoicePath',
		value: settings.invoicePath,
		placeholder: 'account/invoice?number={number}',
		errors: settings.getErrors('invoicePath'),
	}) }}
{% endif %}

{% if isOrderBilling %}
	{{ forms.editableTableField({
		label: 'settings.reminders'|t('net-terms'),
		instructions: 'settings.remindersOrdersInstructions'|t('net-terms', { url: cpUrl('commerce/settings/emails') }),
		id: 'reminders',
		name: 'reminders',
		cols: {
			days: {
				type: 'number',
				heading: 'settings.reminderDays'|t('net-terms'),
				thin: true,
			},
			type: {
				type: 'select',
				heading: 'settings.reminderTiming'|t('net-terms'),
				options: [
					{ label: 'settings.reminderBefore'|t('net-terms'), value: 'dueSoon' },
					{ label: 'settings.reminderAfter'|t('net-terms'), value: 'overdue' },
				],
			},
			emailUid: {
				type: 'select',
				heading: 'settings.reminderEmail'|t('net-terms'),
				options: [{ label: 'settings.chooseEmail'|t('net-terms'), value: '' }]|merge(commerceEmails|map(email => { label: email.name, value: email.uid })|values),
			},
			enabled: {
				type: 'lightswitch',
				heading: 'settings.reminderEnabled'|t('net-terms'),
				thin: true,
			},
		},
		rows: settings.reminders,
		defaultValues: { type: 'dueSoon', enabled: true },
		allowAdd: true,
		allowDelete: true,
		allowReorder: true,
		addRowLabel: 'settings.addReminder'|t('net-terms'),
		errors: settings.getErrors('reminders'),
	}) }}

	{# Post the invoice PDF settings unchanged, since a save keeps only the settings it posts #}
	{{ hiddenInput('invoicePdfTemplate', settings.invoicePdfTemplate) }}
	{{ hiddenInput('invoicePdfPaperSize', settings.invoicePdfPaperSize) }}
	{{ hiddenInput('invoicePdfOrientation', settings.invoicePdfOrientation) }}
{% else %}
	{% embed '_includes/forms/field' with {
		label: 'settings.reminders'|t('net-terms'),
		instructions: 'settings.remindersInvoiceInstructions'|t('net-terms', { url: cpUrl('net-terms/emails') }),
	} %}
		{% block input %}{% endblock %}
	{% endembed %}

	<hr>

	<h2>{{ 'settings.invoicePdf'|t('net-terms') }}</h2>

	{{ forms.autoSuggestField({
		label: 'settings.invoicePdfTemplate'|t('net-terms'),
		instructions: 'settings.invoicePdfTemplateInstructions'|t('net-terms'),
		id: 'invoicePdfTemplate',
		name: 'invoicePdfTemplate',
		value: settings.invoicePdfTemplate,
		suggestions: craft.cp.getTemplateSuggestions(),
		errors: settings.getErrors('invoicePdfTemplate'),
	}) }}

	{{ forms.selectField({
		label: 'settings.invoicePdfPaperSize'|t('net-terms'),
		id: 'invoicePdfPaperSize',
		name: 'invoicePdfPaperSize',
		value: settings.invoicePdfPaperSize,
		options: [
			{ label: 'settings.paperLetter'|t('net-terms'), value: 'letter' },
			{ label: 'settings.paperLegal'|t('net-terms'), value: 'legal' },
			{ label: 'settings.paperA4'|t('net-terms'), value: 'a4' },
		],
		errors: settings.getErrors('invoicePdfPaperSize'),
	}) }}

	{{ forms.selectField({
		label: 'settings.invoicePdfOrientation'|t('net-terms'),
		id: 'invoicePdfOrientation',
		name: 'invoicePdfOrientation',
		value: settings.invoicePdfOrientation,
		options: [
			{ label: 'settings.pdfPortrait'|t('net-terms'), value: 'portrait' },
			{ label: 'settings.pdfLandscape'|t('net-terms'), value: 'landscape' },
		],
		errors: settings.getErrors('invoicePdfOrientation'),
	}) }}

	{# Post the order-billing reminders unchanged, since a save keeps only the settings it posts #}
	{% for reminder in settings.reminders %}
		{% set reminderIndex = loop.index0 %}
		{% for key, value in reminder %}
			{{ hiddenInput("reminders[#{reminderIndex}][#{key}]", value is same as(true) ? '1' : (value is same as(false) ? '' : value)) }}
		{% endfor %}
	{% endfor %}
{% endif %}
