{% if canManagePayments %}
	<div class="nt-section-header">
		<a class="btn" href="{{ url('net-terms/payments/new', { accountId: account.id }) }}">{{ 'payment.record'|t('net-terms') }}</a>
	</div>
{% endif %}

{% if payments|length %}
	{% include 'net-terms/payments/_table' with { showAccount: false } %}
	{% include '_includes/pagination' with { pageInfo: pageInfo, itemLabel: 'payment.item'|t('net-terms'), itemsLabel: 'payment.items'|t('net-terms') } %}
{% else %}
	<p class="light">{{ 'payment.none'|t('net-terms') }}</p>
{% endif %}
