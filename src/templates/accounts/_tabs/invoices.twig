{% if canManagePayments %}
	<div class="nt-section-header">
		<div class="buttons">
			<a class="btn add icon" href="{{ url('net-terms/invoices/new', { accountId: account.id }) }}">{{ 'invoice.new'|t('net-terms') }}</a>
		</div>
	</div>
{% endif %}

{% if invoices|length %}
	{% include 'net-terms/invoices/_table' with { showAccount: false } %}
	{% include '_includes/pagination' with { pageInfo: pageInfo, itemLabel: 'invoice.item'|t('net-terms'), itemsLabel: 'invoice.items'|t('net-terms') } %}
{% else %}
	<p class="light">{{ 'invoice.none'|t('net-terms') }}</p>
{% endif %}
