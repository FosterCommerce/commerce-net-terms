{% set netTerms = craft.app.plugins.getPlugin('net-terms') %}
{% set holder = account.getHolder() %}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
	<meta charset="utf-8">
	<title>{{ 'email.invoiceSubject'|t('net-terms', { number: invoice.number }) }}</title>
</head>
<body style="margin: 0; padding: 24px; background: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f2937;">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 8px;">
		<tr>
			<td style="padding: 32px;">
				<h1 style="margin: 0 0 4px; font-size: 22px;">{{ 'email.invoiceHeading'|t('net-terms', { number: invoice.number }) }}</h1>
				<p style="margin: 0 0 24px; color: #6b7280;">{{ holder.name }}</p>

				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
					<tr>
						<td style="padding: 4px 0; color: #6b7280;">{{ 'invoice.dateIssued'|t('net-terms') }}</td>
						<td style="padding: 4px 0; text-align: right;">{{ invoice.dateIssued|date('long') }}</td>
					</tr>
					<tr>
						<td style="padding: 4px 0; color: #6b7280;">{{ 'invoice.dateDue'|t('net-terms') }}</td>
						<td style="padding: 4px 0; text-align: right; font-weight: 600;">{{ invoice.dateDue|date('long') }}</td>
					</tr>
				</table>

				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #e5e7eb;">
					{% for line in invoice.getLines() %}
						{% set buyer = line.getBuyer() %}
						<tr>
							<td style="padding: 10px 0; border-bottom: 1px solid #e5e7eb;">{{ buyer ? buyer.getName() : 'ledger.account'|t('net-terms') }}</td>
							<td style="padding: 10px 0; border-bottom: 1px solid #e5e7eb; text-align: right;">{{ netTerms.invoices.getLineAmount(line)|money }}</td>
						</tr>
					{% endfor %}
					<tr>
						<td style="padding: 12px 0; font-weight: 600;">{{ 'invoice.balance'|t('net-terms') }}</td>
						<td style="padding: 12px 0; text-align: right; font-weight: 600;">{{ netTerms.invoices.getBalance(invoice)|money }}</td>
					</tr>
				</table>

				{% if invoiceUrl %}
					<p style="margin: 24px 0 0;">
						<a href="{{ invoiceUrl }}" style="display: inline-block; padding: 12px 20px; background: #1f2937; color: #ffffff; border-radius: 6px; text-decoration: none;">{{ 'email.viewAndPay'|t('net-terms') }}</a>
					</p>
				{% endif %}
			</td>
		</tr>
	</table>
</body>
</html>
